---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Adonyme — L'Agence des Leads pour les PME/TPE" description="On génère des leads prêts à signer pour les PME/TPE. Base de données, traitement de leads, acquisition multicanal.">
  <script src="https://fast.wistia.com/player.js" async></script>
  <script src="https://fast.wistia.com/embed/64djxuu9ed.js" async type="module"></script>
  <style>wistia-player[media-id='64djxuu9ed']:not(:defined){background:center/contain no-repeat url('https://fast.wistia.com/embed/medias/64djxuu9ed/swatch');display:block;filter:blur(5px);padding-top:51.04%;}</style>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap" rel="stylesheet" />
  <style is:global>
    @keyframes logoScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    .logo-track { animation: logoScroll 25s linear infinite; }
    @keyframes cardScroll { 0% { transform: translateY(0); } 100% { transform: translateY(-50%); } }
    .card-track { animation: cardScroll 18s linear infinite; }
    @keyframes testimScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    .testim-track { animation: testimScroll 22s linear infinite; }
    .testim-track:hover { animation-play-state: paused; }
    @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.75); } }
    .dot-pulse { width: 8px; height: 8px; border-radius: 50%; background: #fb6931; display: inline-block; flex-shrink: 0; animation: pulse 2s ease-in-out infinite; }
    .mob-title-br { display: none; }
    @media (max-width: 768px) { .logo-track { gap: 1.5rem !important; } }
    @keyframes ctaPulse { 0%, 100% { box-shadow: 0 4px 24px rgba(251,105,49,.35), 0 0 0 0 rgba(251,105,49,.4); } 50% { box-shadow: 0 4px 32px rgba(251,105,49,.5), 0 0 0 10px rgba(251,105,49,0); } }
    @keyframes floatA { 0%,100% { transform: translateY(0px) rotate(0deg); } 50% { transform: translateY(-6px) rotate(1deg); } }
    @keyframes floatB { 0%,100% { transform: translateY(0px) rotate(0deg); } 50% { transform: translateY(-5px) rotate(-1deg); } }
    @keyframes floatC { 0%,100% { transform: translateY(0px); } 50% { transform: translateY(-4px); } }
    .cta-pulse { animation: ctaPulse 2s ease-in-out infinite; }
    .dot-pulse:nth-child(1) { animation-delay: 0s; }

    @media (max-width: 768px) {
      html, body { overflow-x: hidden !important; }
      .mob-hero-wrapper { overflow: hidden !important; }

      /* Navbar */
      .mob-nav-links { display: none !important; }
      .mob-nav-cta { display: none !important; }

      /* Hero */
      .mob-hero-grid { grid-template-columns: 1fr !important; padding: 2rem 1.25rem !important; }
      .mob-hero-video { display: none !important; }
      .mob-hero-badges { flex-wrap: wrap !important; white-space: normal !important; gap: 0.5rem !important; }
      .mob-hero-badges > div { white-space: normal !important; }

      /* Le problème — 3 colonnes → 1 colonne */
      .mob-probleme-grid { grid-template-columns: 1fr !important; }
      .mob-probleme-card { border-right: none !important; border-bottom: 1px solid #e2e8f0; padding-left: 0 !important; }
      .mob-probleme-outer { padding: 1rem 1rem !important; }
      .mob-probleme-inner { padding: 1rem !important; }
      .mob-probleme-carte { padding: 1.25rem !important; }

      /* Timeline line — alignée sur le numéro (20px = centre du cercle 40px) */
      .mob-timeline-line { display: none !important; }
      .mob-title-br { display: block; }

      /* Notre Système — steps layout */
      .mob-step-grid { display: flex !important; flex-direction: column !important; gap: 1.5rem !important; margin-bottom: 3rem !important; }
      .mob-step-illus { order: 3 !important; width: 100% !important; }
      .mob-step-illus iframe { width: 100% !important; }
      .mob-challenge-grid { grid-template-columns: 1fr !important; }
      .mob-proc-grid { grid-template-columns: 1fr !important; }
      .mob-testim-wrap { padding: 0 !important; max-width: 100% !important; }
      .mob-testim-mask { mask-image: none !important; -webkit-mask-image: none !important; }
      .mob-step-content { order: 2 !important; }
      .mob-step-num-wrap { order: 1 !important; }
      .mob-step-num { width: 36px !important; height: 36px !important; font-size: 0.75rem !important; border: 3px solid #faf9f6 !important; }

      /* Padding des sections */
      .mob-section-pad { padding: 3rem 1.25rem !important; }

      /* FAQ */
      .mob-faq-pad { padding: 3rem 1.25rem !important; }

      /* Footer */
      .mob-footer { flex-direction: column !important; align-items: flex-start !important; gap: 2rem !important; }
      .mob-table-section { padding: 3rem 1rem 4rem !important; }
      .mob-offres-section { padding: 3rem 1rem 4rem !important; }
      .mob-offres-inner { display: flex !important; flex-direction: column !important; gap: 2rem !important; }
      .mob-offres-left { display: contents !important; }
      .mob-offres-text { order: 1 !important; }
      .mob-offres-video { order: 2 !important; position: static !important; grid-column: unset !important; grid-row: unset !important; width: 100% !important; max-width: 100% !important; }
      .mob-offres-cards { order: 3 !important; grid-column: unset !important; grid-row: unset !important; }
      .mob-offres-grid { grid-template-columns: 1fr !important; }
      .mob-table-header { display: none !important; }
      .mob-table-row { grid-template-columns: 1fr !important; border-bottom: none !important; }
      .mob-table-row + .mob-table-row { border-top: 1px solid #f0ede8 !important; }
      .mob-table-cell-label { padding: 1rem 1.25rem 0.3rem !important; border-left: none !important; }
      .mob-table-cell-price { padding: 0.15rem 1.25rem 0.3rem !important; border-left: none !important; }
      .mob-table-cell-compris { padding: 0.3rem 1.25rem 1rem !important; border-left: none !important; background: none !important; }
      .mob-footer-right { align-items: flex-start !important; }
    }
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Qu'est-ce qu'un lead qualifié selon vos critères ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Lorsqu'un prospect manifeste de l'intérêt pour votre offre, nos outils vérifient automatiquement qu'il correspond aux critères que vous nous avez définis (secteur, poste, taille d'entreprise, zone géographique…). Seuls les profils validés sont livrés."
        }
      },
      {
        "@type": "Question",
        "name": "Comment fonctionne la livraison sous votre marque ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Nous opérons sur nos propres canaux en citant votre entreprise, votre offre ainsi que ses spécificités à chaque étape. Vos prospects savent qu'ils seront contactés par vous, pas par une agence. Nous gérons l'intégralité de la stratégie et de l'opérationnel, vous vous concentrez sur la vente."
        }
      },
      {
        "@type": "Question",
        "name": "Quelle intégration CRM est possible ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Nous pouvons transmettre vos leads sur n'importe quel CRM du marché (HubSpot, Salesforce, Pipedrive, Notion, Airtable…). Si vous n'en avez pas encore, nous vous fournissons une interface dédiée pour suivre votre production en temps réel."
        }
      },
      {
        "@type": "Question",
        "name": "En combien de temps voit-on les premiers résultats ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Les premiers leads arrivent généralement dès le lendemain du lancement. Nous optimisons les campagnes quotidiennement pour améliorer en continu la qualité et le volume des prospects livrés."
        }
      },
      {
        "@type": "Question",
        "name": "Comment est calculé le score d'intention ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Avant le lancement, nous faisons un brief complet pour définir votre ICP (client idéal) et analyser votre offre. Nous mettons ensuite en place un système d'analyse automatique qui filtre chaque prospect entrant selon ces critères. Seuls ceux qui correspondent sont livrés."
        }
      }
    ]
  }
  </script>
  <div id="app-root"></div>
  <script type="module">
    import { createElement as h, useState } from 'https://esm.sh/react@18';
    import { createRoot } from 'https://esm.sh/react-dom@18/client';

    const SECTEURS = [
      { label: 'Recouvrement', emoji: '⚖️' },
      { label: 'Immobilier', emoji: '🏠' },
      { label: 'Assurance', emoji: '🛡️' },
      { label: 'BTP', emoji: '🏗️' },
      { label: 'Énergie', emoji: '⚡' },
      { label: 'Biotech', emoji: '🧬' },
      { label: 'Recrutement', emoji: '👥' },
      { label: 'Autre secteur', emoji: '+' },
    ];

    const STEPS = ['Secteur', 'Projet', 'Profil', 'Estimation'];

    function Simulator() {
      const [step, setStep] = useState(0);
      const [secteur, setSecteur] = useState(null);
      const [budget, setBudget] = useState('');
      const [prenom, setPrenom] = useState('');
      const [email, setEmail] = useState('');

      const selectSecteur = (s) => {
        setSecteur(s);
        setStep(1);
      };

      return h('div', { style: { background: '#fff', borderRadius: '16px', padding: '2rem', boxShadow: '0 4px 40px rgba(0,0,0,0.10)', maxWidth: '480px', width: '100%' } },
        h('h2', { style: { fontSize: '1.4rem', fontWeight: 800, marginBottom: '0.25rem' } },
          'Simulez votre ', h('span', { style: { color: '#fb6931', fontStyle: 'italic' } }, 'coût par lead')
        ),
        h('p', { style: { color: '#27454F', fontSize: '1.1rem', marginBottom: '1.5rem' } },
          '30 secondes. Recevez une estimation chiffrée pour votre activité.'
        ),
        h('div', { style: { display: 'flex', gap: '0.5rem', marginBottom: '1.5rem', alignItems: 'center' } },
          STEPS.map((s, i) =>
            h('div', { key: s, style: { display: 'flex', alignItems: 'center', gap: '0.4rem', flex: 1 } },
              h('div', { style: {
                width: '28px', height: '28px', borderRadius: '50%', display: 'flex', alignItems: 'center', justifyContent: 'center',
                background: i === step ? '#0a0a0a' : i < step ? '#fb6931' : '#e2e8f0',
                color: i === step ? '#fff' : i < step ? '#fff' : '#94a3b8',
                fontWeight: 700, fontSize: '0.8rem', flexShrink: 0
              } }, i + 1),
              h('span', { style: { fontSize: '0.75rem', color: i === step ? '#0a0a0a' : '#94a3b8', fontWeight: i === step ? 700 : 400 } }, s),
              i < STEPS.length - 1 && h('div', { style: { flex: 1, height: '1px', background: '#e2e8f0' } })
            )
          )
        ),
        step === 0 && h('div', null,
          h('h3', { style: { fontWeight: 700, marginBottom: '0.25rem' } }, 'Quel est votre secteur ?'),
          h('p', { style: { color: '#27454F', fontSize: '1.1rem', marginBottom: '1rem' } }, 'Chaque secteur a ses enchères et ses coûts.'),
          h('div', { style: { display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '0.75rem' } },
            SECTEURS.map(s =>
              h('button', {
                key: s.label,
                onClick: () => selectSecteur(s.label),
                style: {
                  padding: '0.85rem', borderRadius: '10px', border: '1.5px solid #e2e8f0',
                  background: '#f8fafc', cursor: 'pointer', fontWeight: 600, fontSize: '0.85rem',
                  display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '0.3rem',
                  transition: 'border-color 0.15s', fontFamily: "'Instrument Sans', system-ui, sans-serif",
                }
              },
                h('span', { style: { fontSize: '1.4rem' } }, s.emoji),
                s.label
              )
            )
          )
        ),
        step === 1 && h('div', null,
          h('h3', { style: { fontWeight: 700, marginBottom: '1rem' } }, 'Quel est votre budget mensuel ?'),
          h('div', { style: { display: 'flex', flexDirection: 'column', gap: '0.75rem' } },
            ['Moins de 1 000€', '1 000€ – 3 000€', '3 000€ – 5 000€', 'Plus de 5 000€'].map(b =>
              h('button', {
                key: b,
                onClick: () => { setBudget(b); setStep(2); },
                style: {
                  padding: '0.9rem 1rem', borderRadius: '10px', border: '1.5px solid #e2e8f0',
                  background: '#f8fafc', cursor: 'pointer', fontWeight: 600, fontSize: '0.9rem',
                  textAlign: 'left', transition: 'border-color 0.15s', fontFamily: "'Instrument Sans', system-ui, sans-serif",
                }
              }, b)
            )
          )
        ),
        step === 2 && h('div', null,
          h('h3', { style: { fontWeight: 700, marginBottom: '1rem' } }, 'Vos coordonnées'),
          h('input', {
            placeholder: 'Votre prénom',
            value: prenom,
            onInput: (e) => setPrenom(e.target.value),
            style: { width: '100%', padding: '0.8rem', borderRadius: '8px', border: '1.5px solid #e2e8f0', marginBottom: '0.75rem', fontSize: '0.9rem', boxSizing: 'border-box', fontFamily: "'Instrument Sans', system-ui, sans-serif" }
          }),
          h('input', {
            placeholder: 'Votre email',
            value: email,
            onInput: (e) => setEmail(e.target.value),
            style: { width: '100%', padding: '0.8rem', borderRadius: '8px', border: '1.5px solid #e2e8f0', marginBottom: '1rem', fontSize: '0.9rem', boxSizing: 'border-box', fontFamily: "'Instrument Sans', system-ui, sans-serif" }
          }),
          h('button', {
            onClick: () => setStep(3),
            style: { width: '100%', padding: '0.9rem', borderRadius: '10px', background: '#fb6931', border: 'none', cursor: 'pointer', fontWeight: 700, fontSize: '1rem', fontFamily: "'Instrument Sans', system-ui, sans-serif" }
          }, 'Voir mon estimation →')
        ),
        step === 3 && h('div', { style: { textAlign: 'center' } },
          h('div', { style: { fontSize: '3rem', marginBottom: '0.5rem' } }, '🎯'),
          h('h3', { style: { fontWeight: 800, fontSize: '1.3rem', marginBottom: '0.5rem' } }, 'Votre estimation est prête !'),
          h('p', { style: { color: '#27454F', marginBottom: '1.5rem' } },
            `Secteur : ${secteur} · Budget : ${budget}`
          ),
          h('a', {
            href: 'https://calendly.com/session-acquisition/30min',
            style: { display: 'block', padding: '0.9rem', borderRadius: '10px', background: '#0a0a0a', color: '#fff', fontWeight: 700, fontSize: '1rem', textDecoration: 'none', fontFamily: "'Instrument Sans', system-ui, sans-serif" }
          }, 'Réserver un appel stratégique →')
        )
      );
    }

    const PROJETS = [
      { img: '/fulgurance-etude-de-cas.webp', label: 'ACQUISITION DIGITALE', headline: '+1000 leads à 7€ CPL', desc: 'Mise en place de toute la stratégie d\'acquisition meta, système complet de qualification et nurturing QVEMA - S3.', kpis: [{ v: '7€', l: 'CPL' }, { v: '+1000', l: 'Leads' }, { v: '135K€', l: 'CA généré' }] },
      { img: '/cerfrance-etude-de-cas.webp', label: 'BASE DE DONNÉES', headline: '1 milliard de CA à travers 720 agences', desc: 'Comment nous avons segmenté et exploité la base de données du plus gros réseau d\'expertise comptable en France pour générer des leads chauds.', kpis: [{ v: '720', l: 'Agences' }, { v: '1 Mrd€', l: 'CA réseau' }] },
      { img: '/gci-etude-de-cas.webp', label: 'AUTOMATISATION IA', headline: 'Répondre à plus de 200 appels d\'offres par jour', desc: 'Générale Continentale Investissements. Nous avons créé une interface, basée sur des signaux détectés par notre système automatisé, dédié aux marchés publics pour capturer des leads chauds.', kpis: [{ v: '200+', l: 'Appels/jour' }, { v: '100%', l: 'Automatisé' }] },
      { img: '/abraham-etude-de-cas.webp', label: 'RECOUVREMENT', headline: '20 leads exclusifs', desc: 'Maîtrise de la publicité pour générer des leads exclusifs et se démarquer de toute concurrence dans le recouvrement de créances.', kpis: [{ v: '20', l: 'Leads excl.' }, { v: '0', l: 'Concurrents' }, { v: '17 ans', l: 'Expérience' }] },
    ];

    function FaqAccordion() {
      const [open, setOpen] = useState(null);
      const items = [
        {
          q: "Qu'est-ce qu'un lead qualifié selon vos critères ?",
          a: "Lorsqu'un prospect manifeste de l'intérêt pour votre offre, nos outils vérifient automatiquement qu'il correspond aux critères que vous nous avez définis (secteur, poste, taille d'entreprise, zone géographique…). Seuls les profils validés sont livrés."
        },
        {
          q: "Comment fonctionne la livraison sous votre marque ?",
          a: "Nous opérons sur nos propres canaux en citant votre entreprise, votre offre ainsi que ses spécificités à chaque étape. Vos prospects savent qu'ils seront contactés par vous, pas par une agence. Nous gérons l'intégralité de la stratégie et de l'opérationnel, vous vous concentrez sur la vente."
        },
        {
          q: "Quelle intégration CRM est possible ?",
          a: "Nous pouvons transmettre vos leads sur n'importe quel CRM du marché (HubSpot, Salesforce, Pipedrive, Notion, Airtable…). Si vous n'en avez pas encore, nous vous fournissons une interface dédiée pour suivre votre production en temps réel."
        },
        {
          q: "En combien de temps voit-on les premiers résultats ?",
          a: "Les premiers leads arrivent généralement dès le lendemain du lancement. Nous optimisons les campagnes quotidiennement pour améliorer en continu la qualité et le volume des prospects livrés."
        },
        {
          q: "Comment est calculé le score d'intention ?",
          a: "Avant le lancement, nous faisons un brief complet pour définir votre ICP (client idéal) et analyser votre offre. Nous mettons ensuite en place un système d'analyse automatique qui filtre chaque prospect entrant selon ces critères. Seuls ceux qui correspondent sont livrés."
        },
      ];
      return h('section', { style: { background: '#fcfaf6', padding: '2rem', display: 'flex', justifyContent: 'center' } },
        h('div', { style: { background: 'linear-gradient(135deg, #fff8f5 0%, #ffeee5 40%, #ffd9c5 70%, #ffcbb0 100%)', borderRadius: '20px', padding: '3rem', display: 'flex', flexDirection: 'column', gap: '1.5rem', width: '100%', maxWidth: '760px' } },
          h('div', { style: { background: '#fff', borderRadius: '16px', padding: '2.5rem 2.5rem 2rem', textAlign: 'center' } },
            h('p', { style: { fontSize: '0.75rem', fontWeight: 700, letterSpacing: '0.1em', color: '#fb6931', marginBottom: '0.75rem' } }, 'FAQ'),
            h('h2', { style: { fontSize: 'clamp(1.6rem, 3vw, 2.2rem)', fontWeight: 700, color: '#0a0a0a', lineHeight: 1.2, margin: 0 } }, 'Questions fréquentes')
          ),
          h('div', { style: { display: 'flex', flexDirection: 'column', gap: '0.75rem' } },
            items.map((item, i) =>
              h('div', { key: i, style: { background: '#fff', borderRadius: '16px', padding: '0 1.75rem', overflow: 'hidden' } },
                h('button', {
                  onClick: function() { setOpen(open === i ? null : i); },
                  style: { width: '100%', display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '1.25rem 0', background: 'none', border: 'none', cursor: 'pointer', textAlign: 'left', gap: '1rem' }
                },
                  h('span', { style: { fontWeight: 700, fontSize: '0.975rem', color: '#0a0a0a' } }, item.q),
                  h('span', { style: { fontSize: '1.2rem', color: '#fb6931', fontWeight: 700, flexShrink: 0, transition: 'transform 0.2s', transform: open === i ? 'rotate(45deg)' : 'rotate(0deg)' } }, '+')
                ),
                open === i && h('p', { style: { color: '#27454F', lineHeight: 1.7, fontSize: '0.925rem', paddingBottom: '1.25rem', margin: 0 } }, item.a)
              )
            )
          )
        )
      );
    }

    function TestimonialsCarousel() {
      const sep = { borderTop: '1px solid rgba(0,0,0,0.08)', margin: '0.6rem 0' };
      const makeCard = function(p, suffix) {
        const kpiItems = p.kpis.map(function(k) {
          return h('div', { key: k.l },
            h('p', { style: { fontSize: '1rem', fontWeight: 900, color: '#0a0a0a', margin: 0 } }, k.v),
            h('p', { style: { fontSize: '0.58rem', color: '#94a3b8', margin: 0, textTransform: 'uppercase', letterSpacing: '0.08em' } }, k.l)
          );
        });
        return h('div', { key: p.img + suffix, style: { flexShrink: 0, width: '280px', marginRight: '20px', borderRadius: '14px', overflow: 'hidden', background: '#fff', border: '1px solid #e2e8f0', display: 'flex', flexDirection: 'column' } },
          h('img', { src: p.img, alt: '', style: { width: '100%', height: '160px', objectFit: 'cover', objectPosition: 'center', display: 'block' } }),
          h('div', { style: { padding: '1.4rem', display: 'flex', flexDirection: 'column', flex: 1 } },
            h('p', { style: { fontSize: '0.6rem', fontWeight: 700, letterSpacing: '0.12em', color: '#fb6931', margin: '0 0 0.25rem' } }, p.label),
            h('h3', { style: { fontSize: '1.05rem', fontWeight: 900, color: '#0a0a0a', lineHeight: 1.2, margin: '0 0 0.5rem' } }, p.headline),
            h('p', { style: { fontSize: '0.82rem', color: '#27454F', lineHeight: 1.5, margin: '0 0 0.5rem', flex: 1 } }, p.desc),
            h('div', { style: sep }),
            h.apply(null, ['div', { style: { display: 'flex', gap: '1.25rem' } }].concat(kpiItems))
          )
        );
      };
      const allCards = PROJETS.map(function(p) { return makeCard(p, '-a'); })
        .concat(PROJETS.map(function(p) { return makeCard(p, '-b'); }));

      return h('div', { style: { background: '#fcfaf6', padding: '5rem 0' } },
        h('div', { style: { maxWidth: '1200px', margin: '0 auto', padding: '0 3rem', marginBottom: '2.5rem', textAlign: 'center' } },
          h('h2', { style: { fontSize: 'clamp(2rem, 4vw, 3.4rem)', fontWeight: 700, lineHeight: 1.15, color: '#0a0a0a', margin: 0 } },
            '+50 ',
            h('span', { style: { color: '#fb6931', fontStyle: 'italic' } }, 'Entreprises'),
            ' transformées'
          )
        ),
        h('div', { className: 'mob-testim-wrap', style: { maxWidth: '1200px', margin: '0 auto', padding: '0 3rem' } },
          h('div', { className: 'mob-testim-mask', style: { overflow: 'hidden', maskImage: 'linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%)', WebkitMaskImage: 'linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%)' } },
            h.apply(null, ['div', { className: 'testim-track', style: { display: 'flex', width: 'max-content', paddingBottom: '0.5rem' } }].concat(allCards))
          )
        )
      );
    }

    function Page() {
